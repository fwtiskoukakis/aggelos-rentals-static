# Exclude WordPress plugin development files
wp-content/plugins/*/_dev/
wp-content/plugins/*/node_modules/
wp-content/plugins/*/vendor/
wp-content/plugins/*/tests/
wp-content/plugins/*/test/

# Exclude cache and temporary files
wp-content/cache/
wp-content/uploads/wpcf7_uploads/
*.log
*.tmp

# Exclude development files
*.md
!README.md
.git/
.gitignore
