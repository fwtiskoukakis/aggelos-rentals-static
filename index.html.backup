                            <path d="M20 8h-1.82l-1.68-4.64C16.19 2.53 15.44 2 14.6 2H9.4c-.84 0-1.59.53-1.9 1.36L5.82 8H4c-1.1 0-2 .9-2 2v2c0 .55.45 1 1 1h1v6c0 1.1.9 2 2 2h1c1.1 0 2-.9 2-2v-5h4v5c0 1.1.9 2 2 2h1c1.1 0 2-.9 2-2v-6h1c.55 0 1-.45 1-1v-2c0-1.1-.9-2-2-2zm-12 0l1.1-3h5.8L15 8H8zm-1 4c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1zm8 0c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z" fill="currentColor"></path>
